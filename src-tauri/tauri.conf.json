{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Timesheet",
  "version": "1.0.0",
  "identifier": "com.timesheet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Timesheet",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Productivity",
    "shortDescription": "Track your work hours",
    "longDescription": "Timesheet - a desktop app to track work hours per project and task."
  }
}
